DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/applyvault
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated exact origins. Production requires HTTPS, with no trailing slash.
FRONTEND_ORIGIN=http://localhost:5500
# Empty ignores all forwarded headers. Set only to verified reverse-proxy IPs/CIDRs.
TRUSTED_PROXY_IPS=
PORT=8000
